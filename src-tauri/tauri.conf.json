{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quartus Prime Standard Edition",
  "version": "0.1.7",
  "identifier": "com.cycloneivstudio.desktop",
  "build": {
    "frontendDist": "shell-dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Quartus Prime Standard Edition",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/cyclone-backend": "sidecar/cyclone-backend",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KILLER3UG/CycloneIVSimulations/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4OTBEMTI2RDAyQjJDREYKUldUZkxDdlFKdEdRaUJQUDViVkpXSXVvQzlIM1d6c2ltY2JmaXIrMjlBdGpwckFBUncwbGlFd0YK"
    }
  }
}
