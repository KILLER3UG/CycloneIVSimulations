      "id": "F09",
      "statement": "LEDs LED1-LED4 on pins 87/86/85/84; anodes to 3.3 V, cathodes through 470 ohm R30-R33; lit = 0",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-leds_dip",
        "PIN",
        "INST",
        "QSF"
      ]
    },
    {
      "id": "F10",
      "statement": "7-segment: 4-digit common-anode; DIG1-4 = 133/135/136/137 through 10 kohm R46-R49 into 8550 PNP high-side drivers; digit ON = 0",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-sevenseg"
      ]
    },
    {
      "id": "F11",
      "statement": "7-segment segments SEG0-7 = 128/121/125/129/132/126/124/127 through 220 ohm R50-R57; segment lit = 0",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-sevenseg",
        "INST"
      ]
    },
    {
      "id": "F12",
      "statement": "SEG bit map: SEG0=a, SEG1=b, SEG2=c, SEG3=d, SEG4=e, SEG5=f, SEG6=g, SEG7=dp (display pins 11=a, 7=b, 4=c, 2=d, 1=e, 10=f, 5=g, 3=dp; SEG0 routes via R52 to display pin 11, SEG1 via R57 to pin 7)",
      "tag": "VERIFIED",
      "sources": [
        "SCH Display sheet",
        "zoom_seg_map.png",
        "3461BS datasheet pin map"
      ]
    },
    {
      "id": "F13",
      "statement": "Buzzer drive: BEEP = PIN_110 -> 2 kohm -> 8550 PNP base, high-side from 3.3 V via 33 ohm; R17 10 kohm pull-up; ON = BEEP 0",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-buzzer_ir",
        "AMP1"
      ]
    },
    {
      "id": "F14",
      "statement": "Fitted buzzer is passive (requires toggling); no on-board oscillator",
      "tag": "UNVERIFIED",
      "sources": [
        "schematic proves topology only; physical test T-BUZZER-1"
      ]
    },
    {
      "id": "F15",
      "statement": "RS232: MAX3232E U4; UART_TXD=114 (T1IN), UART_RXD=115 (R1OUT); DB9 pin 7 = board TX, pin 8 = board RX, pin 5 = GND",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-rs232",
        "AMP1",
        "INST",
        "PIN"
      ]
    },
    {
      "id": "F16",
      "statement": "DB9 pin 7/8 is non-standard vs DTE 2/3/5; straight-through PC cable fails, crossover needed",
      "tag": "VERIFIED",
      "sources": [
        "schematic vs EIA/TIA-232 pinout"
      ]
    },
    {
      "id": "F17",
      "statement": "VGA: VGA_R/G/B = 106/105/104 (1 bit each, 8 colors), HSYNC=101, VSYNC=103; 1 kohm RGB, 33 ohm sync",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "AMP1",
        "INST",
        "PIN"
      ]
    },
    {
      "id": "F18",
      "statement": "PS/2: PS_CLOCK=119, PS_DATA=120; 470 ohm series; 10 kohm pull-ups to 5 V; open-collector idle high",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-ps2_eep",
        "AMP1",
        "INST",
        "PIN"
      ]
    },
    {
      "id": "F19",
      "statement": "Fitted PS/2 device is a keyboard",
      "tag": "UNVERIFIED",
      "sources": [
        "physical test T-PS2-1"
      ]
    },
    {
      "id": "F20",
      "statement": "EEPROM and LM75 are on TWO SEPARATE I2C buses: EEPROM on I2C_SCL/SDA = 99/98, LM75 on FPGA_SCL/SDA = 112/113",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-ps2_eep",
        "PIN",
        "INST"
      ]
    },
    {
      "id": "F21",
      "statement": "AT24C08 on the EEPROM bus: 8 Kbit = 1 KiB, 16-byte pages, 5 ms write cycle, address 0x50 (A2/A1/A0 = GND)",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-ps2_eep",
        "AT24C08 datasheet"
      ]
    },
    {
      "id": "F22",
      "statement": "AT24C08 WP (pin 7) tied to VCC, so writes are blocked on real hardware (read-only)",
      "tag": "VERIFIED",
      "sources": [
        "SCH zoom_eep",
        "AT24C08 datasheet"
      ]
    },
    {
      "id": "F23",
      "statement": "LM75 on the second bus at address 0x48; temperature register 0x00 is 9-bit 0.5 C LSB; OS pin unused",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-ps2_eep",
        "LM75 datasheet"
      ]
    },
    {
      "id": "F24",
      "statement": "LM75 ambient temperature during a classroom run",
      "tag": "UNVERIFIED",
      "sources": [
        "physical test T-LM75-1"
      ]
    },
    {
      "id": "F25",
      "statement": "LCD socket signals: RS=141, RW=138, E=143, D0..D7=142,1,144,3,2,10,7,11; 10 kohm contrast trimmer",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-lcd",
        "INST",
        "PIN"
      ]
    },
    {
      "id": "F26",
      "statement": "LCD socket pin order matches a standard 1602 module",
      "tag": "UNVERIFIED",
      "sources": [
        "physical test T-LCD-1"
      ]
    },
    {
      "id": "F27",
      "statement": "SDRAM HY57V641620, 64 Mbit, 16-bit bus, 4 banks; DQ/A/control pin map as listed",
      "tag": "VERIFIED",
      "sources": [
        "SCH U6",
        "PIN",
        "INST"
      ]
    },
    {
      "id": "F28",
      "statement": "IR receiver output is demodulated, active-low bursts, idle high",
      "tag": "INFERRED",
      "sources": [
        "standard 38 kHz receiver behaviour; part number not marked on schematic"
      ]
    },
    {
      "id": "F29",
      "statement": "IR carrier/protocol is 38 kHz NEC",
      "tag": "UNVERIFIED",
      "sources": [
        "physical test T-IR-1"
      ]
    },
    {
      "id": "F30",
      "statement": "EPCS16 config flash, AS mode; 16 Mbit = 2 MiB; .sof volatile, .pof/.jic persistent",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-jtag",
        "EPCS16 datasheet"
      ]
    },
    {
      "id": "F31",
      "statement": "Unused pins reserved as weak pull-up, as input tri-stated",
      "tag": "VERIFIED",
      "sources": [
        "all vendor QSF"
      ]
    },
    {
      "id": "F32",
      "statement": "Power: 5 V input; 3.3 V (1117-3.3 from 5 V), 2.5 V (1117-2.5 from 5 V), 1.2 V (1117-1.2 from 3.3 V)",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "CROP-power",
        "AMP1"
      ]
    },
    {
      "id": "F33",
      "statement": "Pins 6/8/13 go to the EPCS16 config flash and AS header; pins 24 (P1 header pin 34) and 111 (P1 header pin 4) are free GPIO on the P1 header (P1 header pins 1/2 are GND)",
      "tag": "VERIFIED",
      "sources": [
        "SCH P1 zoom",
        "zoom_p1_pins.png",
        "CROP-leds_dip"
      ]
    },
    {
      "id": "F34",
      "statement": "Pins used by two functions: KEY[n] and ckey[n] share 88-91 by design (DIP wired across the keys); no vendor project assigns a pin twice",
      "tag": "VERIFIED",
      "sources": [
        "PIN footer",
        "QSF",
        "SCH"
      ]
    },
    {
      "id": "F35",
      "statement": "Config flash is EPCS16 on the A2.2; the older A2.1 schematic V2.1 uses M25P16 and OMDAZZ manuals say EPCS16N",
      "tag": "VERIFIED",
      "sources": [
        "SCH",
        "A2.1 schematic V2.1",
        "OMDAZZ manuals",
        "sources.md #16/#12"
      ]
    },
    {
      "id": "F36",
      "statement": "HY57V641620 refresh is 4096 cycles / 64 ms (4096 rows)",
      "tag": "VERIFIED",
      "sources": [
        "HY57V641620 datasheet",
        "sources.md component table"
      ]
    },
    {
      "id": "F37",
      "statement": "AT24C08 control byte 1010 A2 A1 A0 R/W: only A2 is a physical pin; A1/A0 select one of four 256-byte blocks at word addresses 0/256/512/768",
      "tag": "VERIFIED",
      "sources": [
        "AT24C08 datasheet doc0180",
        "sources.md component table"
      ]
    },
    {
      "id": "F38",
      "statement": "LM75 power-up defaults: Thyst = 75 C (0x4B00), Tos = 80 C (0x5000), config = 0x00",
      "tag": "VERIFIED",
      "sources": [
        "LM75B datasheet",
        "sources.md component table"
      ]
    },
    {
      "id": "F39",
      "statement": "Independent online pin tables (dualvim 16 qsf, inaciose, leoo-c1, fsmiamoto, kdg-auts, naelolaiz, LiteX, microCore, MUDAL) agree with the vendor baseline on CLK/RST/KEY/LED/SEG/DIG/UART/LCD/VGA/SDRAM/PS2/I2C/IR/buzzer",
      "tag": "VERIFIED",
      "sources": [
        "sources.md pin-table comparison"
      ]
    }
